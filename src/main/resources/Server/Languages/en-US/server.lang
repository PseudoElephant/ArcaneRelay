# === Block Names & Descriptions ===

items.Pseudo_Arcane_Button.name = Button
items.Pseudo_Arcane_Button.description = Used to trigger other interactions remotely within a certain distance.
items.Pseudo_Arcane_Toggle_Relay.name = Toggle Relay
items.Pseudo_Arcane_Toggle_Relay.description = Used to block or relay signal depending on state.\n\nWhen a signal is received it always toggles it's state. If active it will relay the signal, if inactive it will stop the relay.\n\nInteract with the block to toggle the starting state.
items.Pseudo_Arcane_Discharge.name = Discharge
items.Pseudo_Arcane_Discharge.description = Used to store and stop signals before relaying once fully charged.\n\nWhen a signal is received it is stored, once fully charged the next signal is relayed.\n\nInteract to change the starting number of stored signals, or right click with a block to change the number of stored signals required before relaying.
items.Pseudo_Arcane_Relay.name = Relay
items.Pseudo_Arcane_Relay.description = Used to relay signals to trigger other interactions remotely within a certain distance.\n\nInteract to send a signal.
items.Pseudo_Arcane_Pusher.name = Pusher
items.Pseudo_Arcane_Pusher.description = Used to push blocks forwards. Blocks will be moved in the direction at which the Pusher is facing.\n\nInteract to activate.
items.Pseudo_Arcane_Pusher_Wall.name = Pusher - Wall Variant
items.Pseudo_Arcane_Pusher_Wall.description = Used to push blocks up and down. Blocks will be moved in the direction at which the Pusher is facing.\n\nInteract to activate\n\nPrefer regular Pusher instead, this item is just used to allow the wall rotations.
items.Pseudo_Arcane_Staff.name = Arcane Staff
items.Pseudo_Arcane_Staff.description = Required to configure Arcane Artifacts. Used to setup connections within Arcane blocks.
items.Pseudo_Arcane_Puller.name = Puller
items.Pseudo_Arcane_Puller.description = Used to pull back a block from far away. When a signal is received it will either extend to reach a target or pull back once it has one.
items.Pseudo_Arcane_Puller_Extension.name = Puller Extension
items.Pseudo_Arcane_Puller_Extension.description = Block responsible for pulling back entities and blocks with the Puller.
items.Pseudo_Arcane_Breaker.name = Breaker
items.Pseudo_Arcane_Breaker.description = Used to slowley break the block on top of it. Can be triggered remotely and rotated.
items.Pseudo_Arcane_Rotator.name = Rotator
items.Pseudo_Arcane_Rotator.description = Used to rotate blocks 90 degrees.\n\nInteract while crouching to switch between clockwise and counterclockwise rotation.
items.Antiquarian_Bench.name = Antiquarian's Workbench
items.Antiquarian_Bench.description = Used to craft ancient mechanism that allow for logic and automation.
items.Pseudo_Arcane_Pixel.name = Pixel
items.Pseudo_Arcane_Pixel.description = A colorful makeshift light capable of switching colors. \n\nInteract while crouching to switch between the available colors.

