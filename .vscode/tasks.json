{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Hytale: Run Server",
            "type": "shell",
            "command": "./gradlew",
            "args": ["runServer", "-Ddebug=true", "-Dhotswap=true"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*$",
                    "endsPattern": "^.*Hytale Server Booted!.*$"
                }
            },
            "group": "none"
        },
        {
            "label": "Hytale: Setup Dev Environment",
            "type": "shell",
            "command": "./gradlew",
            "args": ["setupHytaleDev", "prepareDecompiledSourcesForIde"],
            "group": "none",
            "problemMatcher": []
        }
    ]
}
